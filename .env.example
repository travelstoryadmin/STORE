# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server-only Supabase service role key. NEVER expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Long random secret used to sign the Travel Store HTTP-only session cookie.
TRAVEL_SESSION_SECRET=YOUR_LONG_RANDOM_SESSION_SECRET
